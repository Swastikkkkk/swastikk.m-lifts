# ---------------------------------------------------------------------------
# READ THIS BEFORE YOU PUT ANYTHING HERE.
#
# This site is plain static HTML with no build step. Nothing in this file is
# ever read by index.html. The browser cannot see .env — it only ever gets the
# files you publish.
#
# So this file is a NOTEBOOK, not a config. It is where you keep the values you
# paste by hand into the two places that actually use them:
#
#   PUBLIC values  -> paste into index.html   (safe, they are meant to be public)
#   SECRET values  -> paste into backend/code.gs, which runs on Google's servers
#                     and is never downloaded by a visitor
#
# .gitignore keeps this file out of git, which is good practice, but note that a
# private repo would not have protected you anyway: the risk was never the repo,
# it was that index.html gets sent to every visitor's browser.
# ---------------------------------------------------------------------------

# --- PUBLIC: safe to paste into index.html ---------------------------------

# Your live site root, no trailing slash. Find-and-replace SITE_URL in
# index.html, robots.txt and sitemap.xml with this value.
SITE_URL=https://swastikk-m.vercel.app

# Cloudflare Web Analytics token. Replace CF_ANALYTICS_TOKEN in index.html.
# Public by design — it only identifies which site the pageview belongs to.
CF_ANALYTICS_TOKEN=

# The neighbourhood/area of your gym, for the structured data.
# Replace LOCALITY in index.html. e.g. Dehmi Kalan
LOCALITY=

# --- SECRET: paste into backend/code.gs ONLY, never into index.html ---------

# Shared password between the site and the Apps Script.
# NOTE: because the site must send it, a copy of this value is visible in
# index.html to anyone who views source. It stops drive-by bots, not a
# determined person. Treat it as a speed bump, not a lock.
SL_SECRET_KEY=

# Where new application emails go. Set NOTIFY_EMAIL in backend/code.gs.
NOTIFY_EMAIL=
